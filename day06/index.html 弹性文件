<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
<style>
.box{width: 510px;  height: 500px;  background-color: pink;

        /* 主轴的代码： 
        /* display: flex; 允许主轴方向排列 */
         /* justify-content: ;主轴对齐方式，即调整元素的间距。如：justify-content: space-around/space-between; */

        display: flex;



        /* 副轴代码：
         /* flex-wrap: ; 允许换行 */
         /* align-items:center/end/flex-end/flex-start ;     副轴对齐方式 */
        /* align-content: flex-start/flex-end/center/space-between/space-around/spance-evenly; “换行方式” */

        /* flex-wrap: wrap; */



        /* 以上代码默认x轴为主轴，y轴为副轴，更换主副轴：flex-direction: column; */

        /* flex-direction: column; */
    


        /* gap: 20px 30px;  gap的前数字（20）代表主轴与主轴间的间距，后数字（30）代表副轴与副轴间的间距 */

        /* gap: 10px 30px; */
    }




.son{width: 100px;  height: 100px;  background-color: orange;
     border: 1px solid red;
    /* 不允许缩放，默认值是1，允许缩放，若为0则不可以缩放，代码：flex-shrink：; */
    flex-shrink: 0;
    
    
    }

.son1{   
        /* flex-grow: 1; 定义子元素在主轴方向上的扩展比例 */
        /* flex:1 1;（以上的简写）
           复合属性；扩展比例 是否缩放 */
        flex:1 1;

}





</style>





</head>
<div class="box">
<div class="son son1">1</div>
<div class="son son2">2</div>
<div class="son son3">3</div>
<div class="son son4">4</div>
